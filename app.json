{
  "expo": {
    "name": "توصيل أشمون",
    "slug": "ashmoun-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "ashmoundelivery",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mohamedsafty.ashmoundelivery",
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohamedsafty.ashmoundelivery",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "بنستخدم موقعك عشان المندوب يوصلك أسرع."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9480F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false,
      "turboModules": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "forcesRTL": true,
      "eas": {
        "projectId": "409216b3-cd36-49da-8fed-1872fe8ac9c5"
      }
    },
    "owner": "omar_mahmoud_10",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/409216b3-cd36-49da-8fed-1872fe8ac9c5"
    }
  }
}
